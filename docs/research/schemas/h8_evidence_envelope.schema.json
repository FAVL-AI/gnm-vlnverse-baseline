{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://frank.vanlaarhoven/h8/h8_evidence_envelope.schema.json",
  "title": "H8 Render/Drive Evidence Envelope",
  "description": "Versioned, fail-closed evidence contract binding render-valid or drive-valid evidence to ONE H8 synthetic-fork hospital capture instance. DESIGN-GATE artifact: a schema-valid record is NOT runtime (Level-3) evidence. Mirrors scripts/gnm/h8_evidence_schema.py; that pure validator is authoritative for cross-field policy (freshness, revocation, digests, pairing).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "evidence_id", "evidence_type", "status", "subject", "context", "producer",
    "observation_time", "issue_time", "validity_window", "integrity", "provenance", "revocation",
    "payload"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "h8-evidence/1.0.0" },
    "evidence_id": { "type": "string", "pattern": "^h8ev-[a-z]+-[a-z0-9]{2,}-[0-9]{4,}$" },
    "evidence_type": { "type": "string", "enum": ["render_valid", "drive_valid"] },
    "status": { "type": "string", "enum": ["valid", "invalid", "indeterminate", "revoked"] },
    "observation_time": { "type": "string", "format": "date-time" },
    "issue_time": { "type": "string", "format": "date-time" },
    "subject": { "$ref": "#/$defs/subject" },
    "context": { "$ref": "#/$defs/context" },
    "producer": { "$ref": "#/$defs/producer" },
    "validity_window": { "$ref": "#/$defs/validity_window" },
    "integrity": { "$ref": "#/$defs/integrity" },
    "provenance": { "$ref": "#/$defs/provenance" },
    "revocation": { "$ref": "#/$defs/revocation" },
    "payload": { "type": "object" }
  },
  "allOf": [
    {
      "if": { "properties": { "evidence_type": { "const": "render_valid" } } },
      "then": { "properties": { "payload": { "$ref": "#/$defs/render_payload" } } }
    },
    {
      "if": { "properties": { "evidence_type": { "const": "drive_valid" } } },
      "then": { "properties": { "payload": { "$ref": "#/$defs/drive_payload" } } }
    }
  ],
  "$defs": {
    "sha256_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dataset_plan_id", "instance_id", "split", "scene_id", "scene_digest", "route_id",
        "route_plan_digest", "config_digest", "cl_bound_xy", "coordinate_frame"
      ],
      "properties": {
        "dataset_plan_id": { "type": "string", "minLength": 1 },
        "instance_id": { "type": "string", "minLength": 1 },
        "split": { "type": "string", "enum": ["train", "val", "test"] },
        "scene_id": { "type": "string", "minLength": 1 },
        "scene_digest": { "$ref": "#/$defs/sha256_digest" },
        "route_id": { "type": "string", "minLength": 1 },
        "route_plan_digest": { "$ref": "#/$defs/sha256_digest" },
        "start_pose": { "$ref": "#/$defs/pose" },
        "goal_ref": { "type": "object" },
        "config_digest": { "$ref": "#/$defs/sha256_digest" },
        "cl_bound_xy": { "const": 6.0 },
        "coordinate_frame": { "type": "string", "minLength": 1 },
        "sim_context": { "$ref": "#/$defs/sim_context" }
      }
    },
    "pose": {
      "type": "object",
      "required": ["xy", "yaw", "frame"],
      "properties": {
        "xy": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 },
        "yaw": { "type": "number" },
        "frame": { "type": "string" }
      }
    },
    "sim_context": {
      "type": "object",
      "properties": {
        "simulator": { "type": "string" },
        "version": { "type": "string" }
      }
    },
    "context": {
      "type": "object",
      "properties": {
        "route_family": { "type": "string" },
        "claim_boundary": { "type": "string", "const": "SYNTHETIC_DIAGNOSTIC_ONLY" },
        "capture_mode": { "type": "string" }
      }
    },
    "producer": {
      "type": "object",
      "required": ["component", "version"],
      "properties": {
        "component": { "type": "string", "minLength": 1 },
        "version": { "type": "string" },
        "method": { "type": "string" },
        "key_id": { "type": ["string", "null"] }
      }
    },
    "validity_window": {
      "type": "object",
      "required": ["not_before", "not_after", "clock_source"],
      "properties": {
        "not_before": { "type": "string", "format": "date-time" },
        "not_after": { "type": "string", "format": "date-time" },
        "max_age_seconds": { "type": ["integer", "null"], "minimum": 0 },
        "clock_source": { "type": "string", "enum": ["utc"] },
        "clock_skew_seconds": { "type": "integer", "minimum": 0 }
      }
    },
    "integrity": {
      "type": "object",
      "required": [
        "canonicalization", "digest_algorithm", "subject_digest", "payload_digest", "content_digest",
        "verification_status"
      ],
      "properties": {
        "canonicalization": { "type": "string", "const": "h8-canonical-json/1.0" },
        "digest_algorithm": { "type": "string", "const": "sha256" },
        "subject_digest": { "$ref": "#/$defs/sha256_digest" },
        "payload_digest": { "$ref": "#/$defs/sha256_digest" },
        "content_digest": { "$ref": "#/$defs/sha256_digest" },
        "signature": { "type": ["string", "null"] },
        "signature_algorithm": { "type": ["string", "null"] },
        "key_id": { "type": ["string", "null"] },
        "verification_status": { "type": "string", "enum": ["unsigned", "unverified", "verified"] }
      }
    },
    "provenance": {
      "type": "object",
      "required": ["producer_component", "producer_version", "source_commit", "method_id"],
      "properties": {
        "producer_component": { "type": "string" },
        "producer_version": { "type": "string" },
        "source_commit": { "type": "string" },
        "run_id": { "type": "string" },
        "host_label": { "type": "string" },
        "method_id": { "type": "string" },
        "scene_source": { "type": "string" },
        "config_source": { "type": "string" },
        "parent_evidence_id": { "type": ["string", "null"] },
        "generated_at": { "type": "string", "format": "date-time" },
        "review_state": { "type": "string", "enum": ["none", "pending", "approved", "rejected"] }
      }
    },
    "revocation": {
      "type": "object",
      "required": ["revoked"],
      "properties": {
        "revoked": { "type": "boolean" },
        "revoked_at": { "type": ["string", "null"], "format": "date-time" },
        "reason": { "type": ["string", "null"] },
        "authority": { "type": ["string", "null"] },
        "replacement_evidence_id": { "type": ["string", "null"] },
        "supersedes": { "type": ["string", "null"] }
      }
    },
    "render_payload": {
      "type": "object",
      "required": [
        "scene_loaded", "camera_present", "camera_transform_matches", "resolution", "encoding",
        "frame_nonempty", "frame_not_constant", "required_geometry_visible",
        "no_invalid_render_condition", "validation_method", "thresholds", "diagnostic_ref"
      ],
      "properties": {
        "scene_loaded": { "type": "boolean" },
        "camera_present": { "type": "boolean" },
        "camera_transform_matches": { "type": "boolean" },
        "resolution": { "type": "array", "items": { "type": "integer", "minimum": 1 },
          "minItems": 2, "maxItems": 2 },
        "encoding": { "type": "string" },
        "frame_nonempty": { "type": "boolean" },
        "frame_not_constant": { "type": "boolean" },
        "required_geometry_visible": { "type": "boolean" },
        "no_invalid_render_condition": { "type": "boolean" },
        "validation_method": { "type": "string" },
        "thresholds": { "type": "object" },
        "diagnostic_ref": { "type": "string" }
      }
    },
    "drive_payload": {
      "type": "object",
      "required": [
        "start_bound_to_instance", "goal_bound_to_instance", "within_spatial_bounds",
        "collision_feasible", "min_clearance_m", "clearance_threshold_m", "avoids_prohibited_geometry",
        "route_length_m", "waypoint_count", "coordinate_frame", "validation_method", "planner_version",
        "sim_context", "degraded", "diagnostic_ref"
      ],
      "properties": {
        "start_bound_to_instance": { "type": "boolean" },
        "goal_bound_to_instance": { "type": "boolean" },
        "within_spatial_bounds": { "type": "boolean" },
        "collision_feasible": { "type": "boolean" },
        "min_clearance_m": { "type": "number", "minimum": 0 },
        "clearance_threshold_m": { "type": "number", "minimum": 0 },
        "avoids_prohibited_geometry": { "type": "boolean" },
        "route_length_m": { "type": "number", "minimum": 0 },
        "waypoint_count": { "type": "integer", "minimum": 2 },
        "coordinate_frame": { "type": "string" },
        "validation_method": { "type": "string" },
        "planner_version": { "type": "string" },
        "sim_context": { "$ref": "#/$defs/sim_context" },
        "degraded": { "type": "boolean" },
        "diagnostic_ref": { "type": "string" }
      }
    }
  }
}
