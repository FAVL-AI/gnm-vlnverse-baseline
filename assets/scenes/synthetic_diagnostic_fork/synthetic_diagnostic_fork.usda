#usda 1.0
(
    "SYNTHETIC_DIAGNOSTIC_ONLY — H8-M Track-B authored 4-way cross junction."
    "UNVALIDATED design artifact: NOT yet render-checked, drive-validated, recorded, trained,"
    "or committed. NOT the hospital, NOT a real-world scene, NOT benchmark evidence."
    "Governed by assets/experiments/hospital_h8_track_b_synthetic_fork/ (spec + claim boundary)."
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Z"
    customLayerData = {
        string diagnostic_label = "SYNTHETIC_DIAGNOSTIC_ONLY"
        string junction_type = "four_way_cross"
        string status = "DESIGN_UNVALIDATED_NOT_RENDERED_NOT_DRIVEN_NOT_TRAINED"
        string cl_bound_xy = "unchanged (6.0); scene fits within +/-3.5 m"
    }
)

def Xform "World"
{
    custom string diagnostic_label = "SYNTHETIC_DIAGNOSTIC_ONLY"

    # ---- Lighting ----
    # R4: raised dome + added distant fill so the narrowed West corridor under the big overhead
    # cone stays render-valid (R4 first pass left the West goal view underlit, luma < 15).
    def DomeLight "Dome"
    {
        float inputs:intensity = 3500
    }
    def DistantLight "SunFill"
    {
        float inputs:intensity = 1200
        float inputs:angle = 3.0
        double3 xformOp:rotateXYZ = (-42, 0, 28)
        uniform token[] xformOpOrder = ["xformOp:rotateXYZ"]
    }

    # ---- Materials ----
    def Scope "Looks"
    {
        def Material "MatWall"
        {
            token outputs:surface.connect = </World/Looks/MatWall/Shader.outputs:surface>
            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.70, 0.70, 0.72)
                float inputs:roughness = 0.8
                token outputs:surface
            }
        }
        def Material "MatBlue"
        {
            token outputs:surface.connect = </World/Looks/MatBlue/Shader.outputs:surface>
            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.10, 0.20, 0.85)
                token outputs:surface
            }
        }
        def Material "MatGreen"
        {
            token outputs:surface.connect = </World/Looks/MatGreen/Shader.outputs:surface>
            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.10, 0.70, 0.20)
                token outputs:surface
            }
        }
        def Material "MatOrange"
        {
            token outputs:surface.connect = </World/Looks/MatOrange/Shader.outputs:surface>
            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.95, 0.50, 0.10)
                token outputs:surface
            }
        }
        def Material "MatRed"
        {
            token outputs:surface.connect = </World/Looks/MatRed/Shader.outputs:surface>
            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.85, 0.15, 0.15)
                token outputs:surface
            }
        }
        def Material "MatWhite"
        {
            token outputs:surface.connect = </World/Looks/MatWhite/Shader.outputs:surface>
            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.95, 0.95, 0.95)
                token outputs:surface
            }
        }
        def Material "MatDark"
        {
            token outputs:surface.connect = </World/Looks/MatDark/Shader.outputs:surface>
            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.11, 0.11, 0.13)
                float inputs:roughness = 0.7
                token outputs:surface
            }
        }
        def Material "MatYellow"
        {
            token outputs:surface.connect = </World/Looks/MatYellow/Shader.outputs:surface>
            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.94, 0.84, 0.12)
                token outputs:surface
            }
        }
        def Material "MatWallN"
        {
            token outputs:surface.connect = </World/Looks/MatWallN/Shader.outputs:surface>
            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.42, 0.54, 0.86)
                float inputs:roughness = 0.8
                token outputs:surface
            }
        }
        def Material "MatWallW"
        {
            token outputs:surface.connect = </World/Looks/MatWallW/Shader.outputs:surface>
            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.46, 0.74, 0.48)
                float inputs:roughness = 0.8
                token outputs:surface
            }
        }
        def Material "MatWallE"
        {
            token outputs:surface.connect = </World/Looks/MatWallE/Shader.outputs:surface>
            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.90, 0.66, 0.40)
                float inputs:roughness = 0.8
                token outputs:surface
            }
        }
        def Material "MatWallS"
        {
            token outputs:surface.connect = </World/Looks/MatWallS/Shader.outputs:surface>
            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.85, 0.50, 0.52)
                float inputs:roughness = 0.8
                token outputs:surface
            }
        }
    }

    # ---- Structure: floor, corridor side walls, coloured end panels, markers ----
    # Cube "size = 2" => unit half-extents (1,1,1); xformOp:scale sets half-extents in metres.
    # Navigable + cross: half-width 1.0 m, arm length 3.5 m, wall height 2.5 m, thickness 0.1 m.
    # Floor-cue arrow decals (forward/left/right/start) are TODO for the build step.
    def Xform "Structure"
    {
        def Cube "Floor" (prepend apiSchemas = ["MaterialBindingAPI"])
        {
            double size = 2
            rel material:binding = </World/Looks/MatWall>
            double3 xformOp:translate = (0, 0, -0.05)
            double3 xformOp:scale = (4.0, 4.0, 0.05)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        # -- North arm side walls (x = +/-1, y in [1, 3.5]) --
        def Cube "N_wall_W" (prepend apiSchemas = ["MaterialBindingAPI"])
        {
            double size = 2
            rel material:binding = </World/Looks/MatWallN>
            double3 xformOp:translate = (-1.05, 2.25, 1.25)
            double3 xformOp:scale = (0.05, 1.25, 1.25)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }
        def Cube "N_wall_E" (prepend apiSchemas = ["MaterialBindingAPI"])
        {
            double size = 2
            rel material:binding = </World/Looks/MatWallN>
            double3 xformOp:translate = (1.05, 2.25, 1.25)
            double3 xformOp:scale = (0.05, 1.25, 1.25)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        # -- South arm side walls (x = +/-1, y in [-3.5, -1]) --
        def Cube "S_wall_W" (prepend apiSchemas = ["MaterialBindingAPI"])
        {
            double size = 2
            rel material:binding = </World/Looks/MatWallS>
            double3 xformOp:translate = (-1.05, -2.25, 1.25)
            double3 xformOp:scale = (0.05, 1.25, 1.25)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }
        def Cube "S_wall_E" (prepend apiSchemas = ["MaterialBindingAPI"])
        {
            double size = 2
            rel material:binding = </World/Looks/MatWallS>
            double3 xformOp:translate = (1.05, -2.25, 1.25)
            double3 xformOp:scale = (0.05, 1.25, 1.25)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        # -- East arm side walls (y = +/-1, x in [1, 3.5]) --
        def Cube "E_wall_S" (prepend apiSchemas = ["MaterialBindingAPI"])
        {
            double size = 2
            rel material:binding = </World/Looks/MatWallE>
            double3 xformOp:translate = (2.25, -1.05, 1.25)
            double3 xformOp:scale = (1.25, 0.05, 1.25)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }
        def Cube "E_wall_N" (prepend apiSchemas = ["MaterialBindingAPI"])
        {
            double size = 2
            rel material:binding = </World/Looks/MatWallE>
            double3 xformOp:translate = (2.25, 1.05, 1.25)
            double3 xformOp:scale = (1.25, 0.05, 1.25)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        # -- West arm side walls (y = +/-1, x in [-3.5, -1]) --
        def Cube "W_wall_S" (prepend apiSchemas = ["MaterialBindingAPI"])
        {
            double size = 2
            rel material:binding = </World/Looks/MatWallW>
            double3 xformOp:translate = (-2.25, -1.05, 1.25)
            double3 xformOp:scale = (1.25, 0.05, 1.25)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }
        def Cube "W_wall_N" (prepend apiSchemas = ["MaterialBindingAPI"])
        {
            double size = 2
            rel material:binding = </World/Looks/MatWallW>
            double3 xformOp:translate = (-2.25, 1.05, 1.25)
            double3 xformOp:scale = (1.25, 0.05, 1.25)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        # -- Coloured end panels (branch-specific goal cues) --
        def Cube "End_N_blue" (prepend apiSchemas = ["MaterialBindingAPI"])   # branch A (STRAIGHT)
        {
            double size = 2
            rel material:binding = </World/Looks/MatBlue>
            double3 xformOp:translate = (0, 3.55, 1.25)
            double3 xformOp:scale = (1.0, 0.05, 1.25)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }
        def Cube "End_W_green" (prepend apiSchemas = ["MaterialBindingAPI"])  # branch B (LEFT)
        {
            double size = 2
            rel material:binding = </World/Looks/MatGreen>
            double3 xformOp:translate = (-3.55, 0, 1.25)
            double3 xformOp:scale = (0.05, 1.0, 1.25)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }
        def Cube "End_E_orange" (prepend apiSchemas = ["MaterialBindingAPI"]) # distractor (optional route C)
        {
            double size = 2
            rel material:binding = </World/Looks/MatOrange>
            double3 xformOp:translate = (3.55, 0, 1.25)
            double3 xformOp:scale = (0.05, 1.0, 1.25)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }
        def Cube "End_S_red" (prepend apiSchemas = ["MaterialBindingAPI"])    # approach / behind start
        {
            double size = 2
            rel material:binding = </World/Looks/MatRed>
            double3 xformOp:translate = (0, -3.55, 1.25)
            double3 xformOp:scale = (1.0, 0.05, 1.25)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        # -- White marker prims at eye height (placeholders for circle/triangle/square/cross) --
        def Sphere "Marker_N_circle" (prepend apiSchemas = ["MaterialBindingAPI"])
        {
            double radius = 0.18
            rel material:binding = </World/Looks/MatWhite>
            double3 xformOp:translate = (0, 3.35, 1.2)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
        def Cone "Marker_W_triangle" (prepend apiSchemas = ["MaterialBindingAPI"])
        {
            double height = 0.4
            double radius = 0.18
            rel material:binding = </World/Looks/MatWhite>
            double3 xformOp:translate = (-3.35, 0, 1.2)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
        def Cube "Marker_E_square" (prepend apiSchemas = ["MaterialBindingAPI"])
        {
            double size = 2
            rel material:binding = </World/Looks/MatWhite>
            double3 xformOp:translate = (3.35, 0, 1.2)
            double3 xformOp:scale = (0.15, 0.15, 0.15)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }
        def Cylinder "Marker_S_cross" (prepend apiSchemas = ["MaterialBindingAPI"])
        {
            double height = 0.36
            double radius = 0.16
            rel material:binding = </World/Looks/MatWhite>
            double3 xformOp:translate = (0, -3.35, 1.2)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        # ============================================================================
        # R2 branch-specific STRUCTURAL + TEXTURAL identities (gate-6 fix).
        # Each branch gets a distinct SHAPE FAMILY so a structure-focused, largely
        # colour-invariant encoder (DINO) sees genuinely different scenes, not one
        # recoloured corridor: North=ROUND(spheres), West=POINTED(cones),
        # East=BOXY(cubes/crate), South=CYLINDRICAL(cylinder/vertical bars).
        # Big signs sit high on the end wall and wall patterns are flush (depth kept
        # >= 3.0 m); floor props are offset + low so central depth-openness is preserved.
        # ============================================================================

        # ---- North (branch A, blue, ROUND): big circular disc sign + horizontal
        #      industrial stripes + sphere floor prop ----
        def Sphere "N_sign_disc" (prepend apiSchemas = ["MaterialBindingAPI"])
        {
            double radius = 0.6
            rel material:binding = </World/Looks/MatWhite>
            double3 xformOp:translate = (0, 3.34, 1.6)
            double3 xformOp:scale = (1.0, 0.28, 1.0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }
        def Cube "N_stripe_1" (prepend apiSchemas = ["MaterialBindingAPI"])
        {
            double size = 2
            rel material:binding = </World/Looks/MatDark>
            double3 xformOp:translate = (0, 3.47, 0.55)
            double3 xformOp:scale = (0.9, 0.03, 0.06)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }
        def Cube "N_stripe_2" (prepend apiSchemas = ["MaterialBindingAPI"])
        {
            double size = 2
            rel material:binding = </World/Looks/MatDark>
            double3 xformOp:translate = (0, 3.47, 1.0)
            double3 xformOp:scale = (0.9, 0.03, 0.06)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }
        def Cube "N_stripe_3" (prepend apiSchemas = ["MaterialBindingAPI"])
        {
            double size = 2
            rel material:binding = </World/Looks/MatDark>
            double3 xformOp:translate = (0, 3.47, 2.05)
            double3 xformOp:scale = (0.9, 0.03, 0.06)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }
        def Sphere "N_prop_sphere" (prepend apiSchemas = ["MaterialBindingAPI"])
        {
            double radius = 0.28
            rel material:binding = </World/Looks/MatBlue>
            double3 xformOp:translate = (0.68, 2.7, 0.3)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        # ---- West (branch B, green, POINTED): big triangular (cone) sign + cone
        #      floor prop ----
        def Cone "W_sign_triangle" (prepend apiSchemas = ["MaterialBindingAPI"])
        {
            double height = 1.0
            double radius = 0.5
            rel material:binding = </World/Looks/MatYellow>
            double3 xformOp:translate = (-3.33, 0, 1.65)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
        def Cone "W_prop_prism" (prepend apiSchemas = ["MaterialBindingAPI"])
        {
            double height = 0.7
            double radius = 0.32
            rel material:binding = </World/Looks/MatGreen>
            double3 xformOp:translate = (-2.7, 0.68, 0.35)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
        def Cone "W_chevron_lo" (prepend apiSchemas = ["MaterialBindingAPI"])
        {
            double height = 0.45
            double radius = 0.16
            rel material:binding = </World/Looks/MatDark>
            double3 xformOp:translate = (-3.2, -0.55, 0.25)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        # ---- East (branch B distractor, orange, BOXY): big square sign + checker
        #      tiles + crate floor prop ----
        def Cube "E_sign_square" (prepend apiSchemas = ["MaterialBindingAPI"])
        {
            double size = 2
            rel material:binding = </World/Looks/MatWhite>
            double3 xformOp:translate = (3.46, 0, 1.6)
            double3 xformOp:scale = (0.04, 0.5, 0.5)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }
        def Cube "E_tile_1" (prepend apiSchemas = ["MaterialBindingAPI"])
        {
            double size = 2
            rel material:binding = </World/Looks/MatDark>
            double3 xformOp:translate = (3.47, -0.38, 0.7)
            double3 xformOp:scale = (0.03, 0.17, 0.17)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }
        def Cube "E_tile_2" (prepend apiSchemas = ["MaterialBindingAPI"])
        {
            double size = 2
            rel material:binding = </World/Looks/MatDark>
            double3 xformOp:translate = (3.47, 0.38, 0.7)
            double3 xformOp:scale = (0.03, 0.17, 0.17)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }
        def Cube "E_tile_3" (prepend apiSchemas = ["MaterialBindingAPI"])
        {
            double size = 2
            rel material:binding = </World/Looks/MatDark>
            double3 xformOp:translate = (3.47, 0, 1.15)
            double3 xformOp:scale = (0.03, 0.17, 0.17)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }
        def Cube "E_prop_crate" (prepend apiSchemas = ["MaterialBindingAPI"])
        {
            double size = 2
            rel material:binding = </World/Looks/MatOrange>
            double3 xformOp:translate = (2.7, 0.68, 0.32)
            double3 xformOp:scale = (0.3, 0.3, 0.3)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        # ---- South (approach, red, CYLINDRICAL): vertical bars + cylinder prop ----
        def Cube "S_bar_1" (prepend apiSchemas = ["MaterialBindingAPI"])
        {
            double size = 2
            rel material:binding = </World/Looks/MatDark>
            double3 xformOp:translate = (-0.5, -3.47, 1.15)
            double3 xformOp:scale = (0.08, 0.02, 0.8)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }
        def Cube "S_bar_2" (prepend apiSchemas = ["MaterialBindingAPI"])
        {
            double size = 2
            rel material:binding = </World/Looks/MatDark>
            double3 xformOp:translate = (0, -3.47, 1.15)
            double3 xformOp:scale = (0.08, 0.02, 0.8)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }
        def Cube "S_bar_3" (prepend apiSchemas = ["MaterialBindingAPI"])
        {
            double size = 2
            rel material:binding = </World/Looks/MatDark>
            double3 xformOp:translate = (0.5, -3.47, 1.15)
            double3 xformOp:scale = (0.08, 0.02, 0.8)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }
        def Cylinder "S_prop_cylinder" (prepend apiSchemas = ["MaterialBindingAPI"])
        {
            double height = 0.8
            double radius = 0.26
            rel material:binding = </World/Looks/MatRed>
            double3 xformOp:translate = (0.68, -2.7, 0.42)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        # ============================================================================
        # R3 branch-specific CORRIDOR-SHELL distinctness (gate-6 fix, round 3).
        # R2 left every arm sharing an identical gray shell (side walls/floor/ceiling)
        # which dominated the DINO embedding (center N-vs-W 0.62). R3 makes the whole
        # field of view differ per branch: (a) side walls already re-tinted per arm
        # (MatWallN/W/E/S), (b) a branch-colour FLOOR STRIP down each arm, (c) a
        # branch shape-family SIDE-WALL RELIEF along each arm. All reliefs are flush on
        # the walls / flat on the floor (off the central column), so central
        # depth-openness (3.5 m) is preserved.
        # ============================================================================

        # -- Floor strips (branch-colour runner down each arm, flush on floor) --
        def Cube "N_floor_strip" (prepend apiSchemas = ["MaterialBindingAPI"])
        {
            double size = 2
            rel material:binding = </World/Looks/MatBlue>
            double3 xformOp:translate = (0, 2.25, 0.02)
            double3 xformOp:scale = (0.4, 1.25, 0.02)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }
        def Cube "W_floor_strip" (prepend apiSchemas = ["MaterialBindingAPI"])
        {
            double size = 2
            rel material:binding = </World/Looks/MatGreen>
            double3 xformOp:translate = (-2.25, 0, 0.02)
            double3 xformOp:scale = (1.25, 0.4, 0.02)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }
        def Cube "E_floor_strip" (prepend apiSchemas = ["MaterialBindingAPI"])
        {
            double size = 2
            rel material:binding = </World/Looks/MatOrange>
            double3 xformOp:translate = (2.25, 0, 0.02)
            double3 xformOp:scale = (1.25, 0.4, 0.02)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }
        def Cube "S_floor_strip" (prepend apiSchemas = ["MaterialBindingAPI"])
        {
            double size = 2
            rel material:binding = </World/Looks/MatRed>
            double3 xformOp:translate = (0, -2.25, 0.02)
            double3 xformOp:scale = (0.4, 1.25, 0.02)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        # -- North side-wall relief: horizontal ROUND-branch bands (flush at x = +/-0.98) --
        def Cube "N_band_W1" (prepend apiSchemas = ["MaterialBindingAPI"])
        {
            double size = 2
            rel material:binding = </World/Looks/MatWhite>
            double3 xformOp:translate = (-0.98, 2.25, 0.7)
            double3 xformOp:scale = (0.02, 1.2, 0.06)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }
        def Cube "N_band_W2" (prepend apiSchemas = ["MaterialBindingAPI"])
        {
            double size = 2
            rel material:binding = </World/Looks/MatWhite>
            double3 xformOp:translate = (-0.98, 2.25, 1.6)
            double3 xformOp:scale = (0.02, 1.2, 0.06)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }
        def Cube "N_band_E1" (prepend apiSchemas = ["MaterialBindingAPI"])
        {
            double size = 2
            rel material:binding = </World/Looks/MatWhite>
            double3 xformOp:translate = (0.98, 2.25, 0.7)
            double3 xformOp:scale = (0.02, 1.2, 0.06)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }
        def Cube "N_band_E2" (prepend apiSchemas = ["MaterialBindingAPI"])
        {
            double size = 2
            rel material:binding = </World/Looks/MatWhite>
            double3 xformOp:translate = (0.98, 2.25, 1.6)
            double3 xformOp:scale = (0.02, 1.2, 0.06)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        # -- West side-wall relief: POINTED-branch cone pylons lining the corridor base --
        def Cone "W_pylon_1" (prepend apiSchemas = ["MaterialBindingAPI"])
        {
            double height = 0.5
            double radius = 0.14
            rel material:binding = </World/Looks/MatYellow>
            double3 xformOp:translate = (-1.9, -0.82, 0.25)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
        def Cone "W_pylon_2" (prepend apiSchemas = ["MaterialBindingAPI"])
        {
            double height = 0.5
            double radius = 0.14
            rel material:binding = </World/Looks/MatYellow>
            double3 xformOp:translate = (-2.7, -0.82, 0.25)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
