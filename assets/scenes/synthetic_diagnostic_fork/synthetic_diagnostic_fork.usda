    # ---- Reference frame prims (documentation only; not colliders) ----
    def Xform "StartPose_south_facing_north"
    {
        double3 xformOp:translate = (0, -3.0, 0.47)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        custom string note = "start (0,-3.0) heading N (yaw 90); robot-eye z=0.47"
    }
