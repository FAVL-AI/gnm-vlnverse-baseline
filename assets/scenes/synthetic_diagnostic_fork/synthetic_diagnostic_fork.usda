        }

        # ============================================================================
        # R4 per-branch GEOMETRY + dominant FOREGROUND (gate-6 fix, round 4).
        # R3 showed appearance edits cannot beat DINO's sensitivity to the SHARED
        # corridor perspective geometry. R4 changes what DINO sees structurally:
        #  - a LARGE branch-specific object (distinct silhouette) that dominates the
        #    upper frame of the goal view (round sphere / pointed cone / boxy cube /
        #    columns). Objects sit HIGH (bottom z >= ~1.0 m) so they are above the
        #    central depth band from BOTH the junction-centre probe and the goal
        #    cameras -> central depth-openness (3.5 m) is preserved, no near occlusion.
        #  - the WEST corridor is narrowed with inner liner walls (perspective differs
        #    from the native-width NORTH corridor) -> different geometry per branch.
        # ============================================================================

        # -- North (branch A): large ROUND object (dominant sphere overhead-front) --
        def Sphere "N_big_sphere" (prepend apiSchemas = ["MaterialBindingAPI"])
        {
            double radius = 0.85
            rel material:binding = </World/Looks/MatBlue>
            double3 xformOp:translate = (0, 2.5, 1.95)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        # -- West (branch B): large POINTED object (dominant cone) + inner liner walls
        #    narrowing the corridor to +/-0.78 (native N corridor is +/-1.0) --
        def Cone "W_big_cone" (prepend apiSchemas = ["MaterialBindingAPI"])
        {
            double height = 1.5
            double radius = 0.85
            rel material:binding = </World/Looks/MatGreen>
            double3 xformOp:translate = (-2.5, 0, 2.05)
